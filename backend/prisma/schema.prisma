generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model admins {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @unique @db.Uuid
  role            String   @default("admin") @db.VarChar(50)
  users           users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assigned_tasks  tasks[]  @relation("task_employee")
  created_tasks   tasks[]  @relation("task_creator")

  @@index([user_id], map: "idx_admins_user_id")
}

model bookings {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String?          @db.Uuid
  project_type     String?          @db.VarChar(100)
  notes            String?
  meeting_datetime DateTime?        @db.Timestamptz(6)
  status           String           @default("pending") @db.VarChar(20)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  name             String?          @db.VarChar(150)
  meeting_date     DateTime         @db.Date
  meeting_time     DateTime         @db.Time(6)
  email            String?
  phone            String?          @db.VarChar(20)
  agency           String?
  declined_at      DateTime?        @db.Timestamptz(6)
  updated_at       DateTime?        @default(now()) @db.Timestamp(6)
  users            users?           @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  onboard_clients  onboard_clients?
  query_clients    query_clients?

  @@index([meeting_datetime], map: "idx_bookings_meeting_datetime")
  @@index([status], map: "idx_bookings_status")
  @@index([user_id], map: "idx_bookings_user_id")
}

model chat_conversations {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String          @db.Uuid
  status          String          @default("open") @db.VarChar(20)
  last_message_at DateTime?       @db.Timestamptz(6)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  users           users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chat_messages   chat_messages[]

  @@index([user_id], map: "idx_chat_conv_user")
}

model chat_messages {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id    String             @db.Uuid
  sender_type        String             @db.VarChar(10)
  sender_id          String?            @db.Uuid
  message            String
  is_read            Boolean            @default(false)
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  chat_conversations chat_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users              users?             @relation(fields: [sender_id], references: [id], onUpdate: NoAction)

  @@index([conversation_id], map: "idx_chat_msg_conv")
}

model onboard_clients {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String     @db.Uuid
  booking_id   String     @unique @db.Uuid
  company_name String?    @db.VarChar(150)
  contact_name String     @db.VarChar(150)
  email        String     @db.VarChar(255)
  phone        String?    @db.VarChar(20)
  onboarded_at DateTime   @default(now()) @db.Timestamptz(6)
  status       String     @default("active") @db.VarChar(20)
  username     String?    @db.VarChar(100)
  avatar_url   String?
  start_date   DateTime?  @db.Date
  admin_notes  String?
  feedback     String?
  bookings     bookings   @relation(fields: [booking_id], references: [id], onUpdate: NoAction)
  users        users      @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  projects     projects[]

  @@index([booking_id], map: "idx_onboard_clients_booking_id")
  @@index([status], map: "idx_onboard_clients_status")
  @@index([user_id], map: "idx_onboard_clients_user_id")
}

model portfolio {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String    @db.VarChar(200)
  description  String?
  category     String?   @db.VarChar(100)
  image_url    String?
  project_url  String?
  tech_stack   String[]
  completed_at DateTime? @db.Date
  is_featured  Boolean   @default(false)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  link         String?

  @@index([category], map: "idx_portfolio_category")
  @@index([is_featured], map: "idx_portfolio_featured")
}

model project_assignments {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id  String   @db.Uuid
  employee_id String   @db.Uuid
  assigned_by String   @db.Uuid
  status      String   @default("active") @db.VarChar(50)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  projects    projects @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "idx_pa_employee")
  @@index([project_id], map: "idx_pa_project")
  @@index([employee_id], map: "idx_project_assignments_employee")
  @@index([project_id], map: "idx_project_assignments_project")
}

model project_updates {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id  String   @db.Uuid
  message     String
  employee_id String?  @db.Uuid
  author_role String   @default("admin") @db.VarChar(50)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  projects    projects @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([project_id], map: "idx_project_updates_project")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model projects {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id           String?               @db.Uuid
  manager_id          String?               @db.Uuid
  title               String                @db.VarChar(200)
  description         String?
  start_date          DateTime?             @db.Date
  end_date            DateTime?             @db.Date
  status              String                @default("active") @db.VarChar(30)
  total_amount        Decimal               @default(0) @db.Decimal(12, 2)
  expenses            Decimal               @default(0) @db.Decimal(12, 2)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  deadline            DateTime?             @db.Date
  client_name         String?
  project_name        String?
  admin_notes         String?
  status_note         String?
  notes               String?
  project_assignments project_assignments[]
  project_updates     project_updates[]
  onboard_clients     onboard_clients?      @relation(fields: [client_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sales               sales[]
  tasks               tasks[]

  @@index([client_id], map: "idx_projects_client_id")
  @@index([status], map: "idx_projects_status")
}

model query_clients {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id     String    @unique(map: "uq_query_booking") @db.Uuid
  user_id        String    @db.Uuid
  follow_up_date DateTime? @db.Timestamptz(6)
  notes          String?
  status         String    @default("open") @db.VarChar(30)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  name           String?   @db.VarChar(150)
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(20)
  bookings       bookings  @relation(fields: [booking_id], references: [id], onUpdate: NoAction)
  users          users     @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([booking_id], map: "idx_query_clients_booking_id")
  @@index([status], map: "idx_query_clients_status")
  @@index([user_id], map: "idx_query_clients_user_id")
}

model sales {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id     String   @db.Uuid
  paid_amount    Decimal  @db.Decimal(12, 2)
  sale_date      DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  notes          String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  pending_amount Decimal? @default(0) @db.Decimal(12, 2)
  expenses       Decimal? @default(0) @db.Decimal(12, 2)
  amount         Decimal? @default(0) @db.Decimal(12, 2)
  payment_method String?  @db.VarChar(50)
  client_name    String?
  service        String?
  type           String?
  status         String?
  projects       projects @relation(fields: [project_id], references: [id], onUpdate: NoAction)

  @@index([sale_date], map: "idx_sales_payment_date")
  @@index([project_id], map: "idx_sales_project_id")
}

model staff_docs {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  description      String?
  file_url         String
  file_name        String?      @db.VarChar(255)
  file_size        Int?
  uploaded_by      String?      @db.Uuid
  uploaded_by_name String?      @db.VarChar(255)
  sent_to_role     String       @default("manager") @db.VarChar(20)
  sent_to_id       String?      @db.Uuid
  sent_to_name     String?      @db.VarChar(255)
  forwarded_from   String?      @db.Uuid
  forward_note     String?
  created_at       DateTime?    @default(now()) @db.Timestamptz(6)
  staff_docs       staff_docs?  @relation("staff_docsTostaff_docs", fields: [forwarded_from], references: [id], onUpdate: NoAction)
  other_staff_docs staff_docs[] @relation("staff_docsTostaff_docs")

  @@index([sent_to_id, sent_to_role], map: "idx_staff_docs_sent_to")
}

model subscriptions {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  plan         String    @default("free") @db.VarChar(50)
  status       String    @default("active") @db.VarChar(20)
  renewal_date DateTime? @db.Date
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_subscriptions_user_id")
}

model task_notes {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id       String   @db.Uuid
  employee_id   String?  @db.Uuid
  employee_name String?  @db.VarChar(255)
  note          String
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  users         users?   @relation(fields: [employee_id], references: [id], onUpdate: NoAction)
  tasks         tasks    @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([task_id], map: "idx_task_notes_task")
}

model tasks {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id    String?      @db.Uuid
  title         String
  description   String?
  employee_id   String?      @db.Uuid
  assigned_by   String?      @db.Uuid
  status        String       @default("pending") @db.VarChar(50)
  deadline      DateTime?    @db.Date
  manager_notes String?
  updated_at    DateTime?    @db.Timestamptz(6)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  priority      String?      @default("medium") @db.VarChar(50)
  seen_at       DateTime?    @db.Timestamptz(6)
  accepted_at   DateTime?    @db.Timestamptz(6)
  task_notes    task_notes[]
  users         admins?      @relation("task_employee", fields: [employee_id], references: [id], onUpdate: NoAction)
  creator       admins?      @relation("task_creator", fields: [assigned_by], references: [id], onUpdate: NoAction)
  projects      projects?    @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "idx_tasks_employee")
  @@index([project_id], map: "idx_tasks_project")
}

model team_messages {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel     String   @db.VarChar(200)
  sender_name String   @db.VarChar(255)
  sender_id   String?  @db.Uuid
  message     String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  media_url   String?
  media_type  String?  @db.VarChar(50)
  file_name   String?  @db.VarChar(255)

  @@index([channel], map: "idx_team_messages_channel")
  @@index([channel, created_at], map: "idx_team_msg_channel")
}

model users {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username              String               @unique @db.VarChar(50)
  email                 String               @unique @db.VarChar(255)
  password_hash         String
  first_name            String               @db.VarChar(100)
  last_name             String               @db.VarChar(100)
  phone                 String?              @db.VarChar(20)
  business_name         String?              @db.VarChar(150)
  manager_id            String?              @db.Uuid
  created_at            DateTime             @default(now()) @db.Timestamptz(6)
  username_change_count Int                  @default(0)
  profile_picture       String?
  admins                admins?
  bookings              bookings[]
  chat_conversations    chat_conversations[]
  chat_messages         chat_messages[]
  onboard_clients       onboard_clients[]
  query_clients         query_clients[]
  subscriptions         subscriptions[]
  task_notes            task_notes[]

  @@index([email], map: "idx_users_email")
  @@index([username], map: "idx_users_username")
}

model visitor_leads {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String?
  agency_size String?
  country     String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}
