generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model admins {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @unique @db.Uuid
  role    String @default("admin") @db.VarChar(50)
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_admins_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model bookings {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String?          @db.Uuid
  project_type     String?          @db.VarChar(100)
  notes            String?
  meeting_datetime DateTime?        @db.Timestamptz(6)
  status           String           @default("pending") @db.VarChar(20)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  name             String?          @db.VarChar(150)
  meeting_date     DateTime         @db.Date
  meeting_time     DateTime         @db.Time(6)
  email            String?
  agency           String?
  updated_at       DateTime?        @default(now()) @db.Timestamp(6)
  users            users?           @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  onboard_clients  onboard_clients?
  query_clients    query_clients?

  @@index([meeting_datetime], map: "idx_bookings_meeting_datetime")
  @@index([status], map: "idx_bookings_status")
  @@index([user_id], map: "idx_bookings_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model onboard_clients {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String     @db.Uuid
  booking_id   String     @unique @db.Uuid
  company_name String?    @db.VarChar(150)
  contact_name String     @db.VarChar(150)
  email        String     @db.VarChar(255)
  phone        String?    @db.VarChar(20)
  onboarded_at DateTime   @default(now()) @db.Timestamptz(6)
  status       String     @default("active") @db.VarChar(20)
  username     String?    @db.VarChar(100)
  avatar_url   String?
  start_date   DateTime?  @db.Date
  admin_notes  String?
  feedback     String?
  bookings     bookings   @relation(fields: [booking_id], references: [id], onUpdate: NoAction)
  users        users      @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  projects     projects[]

  @@index([booking_id], map: "idx_onboard_clients_booking_id")
  @@index([status], map: "idx_onboard_clients_status")
  @@index([user_id], map: "idx_onboard_clients_user_id")
}

model portfolio {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String    @db.VarChar(200)
  description  String?
  category     String?   @db.VarChar(100)
  image_url    String?
  project_url  String?
  tech_stack   String[]
  completed_at DateTime? @db.Date
  is_featured  Boolean   @default(false)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  link         String?

  @@index([category], map: "idx_portfolio_category")
  @@index([is_featured], map: "idx_portfolio_featured")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model projects {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id       String?          @db.Uuid
  manager_id      String?          @db.Uuid
  title           String           @db.VarChar(200)
  description     String?
  start_date      DateTime?        @db.Date
  end_date        DateTime?        @db.Date
  status          String           @default("active") @db.VarChar(30)
  total_amount    Decimal          @default(0) @db.Decimal(12, 2)
  expenses        Decimal          @default(0) @db.Decimal(12, 2)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  deadline        DateTime?        @db.Date
  client_name     String?
  project_name    String?
  onboard_clients onboard_clients? @relation(fields: [client_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sales           sales[]

  @@index([client_id], map: "idx_projects_client_id")
  @@index([status], map: "idx_projects_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model query_clients {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id     String    @unique(map: "uq_query_booking") @db.Uuid
  user_id        String    @db.Uuid
  follow_up_date DateTime? @db.Timestamptz(6)
  notes          String?
  status         String    @default("open") @db.VarChar(30)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  name           String?   @db.VarChar(150)
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(20)
  bookings       bookings  @relation(fields: [booking_id], references: [id], onUpdate: NoAction)
  users          users     @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([booking_id], map: "idx_query_clients_booking_id")
  @@index([status], map: "idx_query_clients_status")
  @@index([user_id], map: "idx_query_clients_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model sales {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id     String   @db.Uuid
  paid_amount    Decimal  @db.Decimal(12, 2)
  sale_date      DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  notes          String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  pending_amount Decimal? @default(0) @db.Decimal(12, 2)
  expenses       Decimal? @default(0) @db.Decimal(12, 2)
  amount         Decimal? @default(0) @db.Decimal(12, 2)
  payment_method String?  @db.VarChar(50)
  client_name    String?
  service        String?
  type           String?
  status         String?
  projects       projects @relation(fields: [project_id], references: [id], onUpdate: NoAction)

  @@index([sale_date], map: "idx_sales_payment_date")
  @@index([project_id], map: "idx_sales_project_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model subscriptions {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  plan         String    @default("free") @db.VarChar(50)
  status       String    @default("active") @db.VarChar(20)
  renewal_date DateTime? @db.Date
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_subscriptions_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username              String            @unique @db.VarChar(50)
  email                 String            @unique @db.VarChar(255)
  password_hash         String
  first_name            String            @db.VarChar(100)
  last_name             String            @db.VarChar(100)
  phone                 String?           @db.VarChar(20)
  business_name         String?           @db.VarChar(150)
  created_at            DateTime          @default(now()) @db.Timestamptz(6)
  username_change_count Int               @default(0)
  profile_picture       String?
  admins                admins?
  bookings              bookings[]
  onboard_clients       onboard_clients[]
  query_clients         query_clients[]
  subscriptions         subscriptions[]

  @@index([email], map: "idx_users_email")
  @@index([username], map: "idx_users_username")
}
